{
  "theme": "base",
  "look": "classic",
  "fontFamily": "Arial, sans-serif",
  "themeVariables": {
    "fontFamily": "Arial, sans-serif",
    "fontSize": "17px",
    "primaryColor": "#F8FAFC",
    "primaryTextColor": "#0F172A",
    "primaryBorderColor": "#64748B",
    "secondaryColor": "#EFF6FF",
    "tertiaryColor": "#F8FAFC",
    "lineColor": "#475569",
    "textColor": "#0F172A",
    "mainBkg": "#F8FAFC",
    "nodeBorder": "#64748B",
    "clusterBkg": "#F8FAFC",
    "clusterBorder": "#CBD5E1",
    "edgeLabelBackground": "#FFFFFF",
    "actorBkg": "#F8FAFC",
    "actorBorder": "#64748B",
    "actorTextColor": "#0F172A",
    "actorLineColor": "#64748B",
    "signalColor": "#475569",
    "signalTextColor": "#0F172A",
    "labelBoxBkgColor": "#F8FAFC",
    "labelBoxBorderColor": "#64748B",
    "labelTextColor": "#0F172A",
    "loopTextColor": "#0F172A",
    "noteBkgColor": "#EFF6FF",
    "noteTextColor": "#0F172A",
    "noteBorderColor": "#94A3B8"
  },
  "flowchart": {
    "curve": "linear",
    "nodeSpacing": 36,
    "rankSpacing": 48,
    "padding": 16,
    "htmlLabels": false,
    "wrappingWidth": 280,
    "minNodeWidth": 0,
    "look": "classic",
    "theme": "base"
  },
  "sequence": {
    "mirrorActors": false,
    "actorMargin": 48,
    "messageMargin": 36,
    "useMaxWidth": true
  },
  "state": {
    "padding": 16
  },
  "htmlLabels": false,
  "themeCSS": ".edgeLabel rect { opacity: 1 !important; }"
}
